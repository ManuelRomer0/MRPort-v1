---
import Social from "./Social.astro";

const { form } = Astro.props;
---

<section>
  <div
    class="bg-[#171717]/20 border-2 border-[#e8e4ea]/10 py-8 px-8 rounded-lg mx-auto max-w-[600px] mt-20 dark:bg-[#171717]/40"
  >
    <a
      href="https://www.linkedin.com/in/manuelromer0/"
      target="_blank"
      rel="noopener"
    >
    </a>
    <h2
      class="mb-2 text-3xl tracking-tight font-extrabold text-[#0f0c11] dark:text-[#e8e4ea] md:text-4xl"
    >
      {form.title}
    </h2>
    <p class="font-light text-[#0f0c11] dark:text-[#e8e4ea]/80 sm:text-xl">
      {form.subtitle}
    </p>
    <div class="mt-8">
      <a
        href="mailto:manuelromeromoreno13@gmail.com"
        class="flex font-light text-[#B617E6] dark:text-[#FAAB00] sm:text-xl mb-4"
      >
        manuelromeromoreno13@gmail.com
      </a>
      <Social />
      <img
        src="/MRPort-v1/logo-6.png"
        alt="Cat over laptop image"
        class="absolute w-20 sm:w-40 ml-44 sm:ml-80 md:ml-96 -mt-32 sm:-mt-28 hover:animate-tada"
      />
    </div>
  </div>
</section>
