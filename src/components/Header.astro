---
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith("/es");

import { LANGUAGES } from "../i18n/index";
import ThemeToggle from "./ThemeToggle.astro";

const navItems = isSpanish ? LANGUAGES.es.nav : LANGUAGES.en.nav;
const langButtonText = isSpanish ? "EN" : "ES";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const langUrl = isSpanish ? `${base}/` : `${base}/es`;
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2 animate-slide-in-top"
>
  <nav
    class="flex px-3 text-sm font-medium rounded-full gap-2 text-[#0f0c11] dark:text-[#f4f4f4] justify-center items-center md:gap-6"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-[#FAAB00] dark:hover:text-[#FAAB00]"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
    <a
      href={langUrl}
      class="relative block px-2 py-2 transition hover:text-[#FAAB00] dark:hover:text-[#FAAB00] font-bold"
    >
      {langButtonText}
    </a>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500");
            } else {
              item.classList.remove("text-yellow-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur bg-[#B617E6]/40 ring-[#f4f4f4]/10;
    }
  }

  :global(.dark) nav {
    animation-name: nav-shadown-dark;
  }

  @keyframes nav-shadown-dark {
    to {
      @apply shadow-lg ring-1 backdrop-blur bg-[#0f0c11] ring-[#f4f4f4]/10;
    }
  }
</style>
