---
import { LANGUAGES } from "../i18n/index";
import ThemeToggle from "./ThemeToggle.astro";

const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.includes(base + "/es");

const navItems = isSpanish ? LANGUAGES.es.nav : LANGUAGES.en.nav;
const langButtonText = isSpanish ? "EN" : "ES";
const langUrl = isSpanish ? base + "/" : base + "/es";
---

<header
  class="fixed top-0 z-50 flex items-center justify-center w-full mx-auto mt-2 animate-slide-in-top px-4"
>
  <nav
    class="flex px-3 py-1 text-sm font-medium rounded-full gap-2 text-[#0f0c11] dark:text-[#f4f4f4] justify-center items-center md:gap-5 shadow-lg ring-1 backdrop-blur bg-white/50 dark:bg-[#0f0c11]/50 ring-[#f4f4f4]/10"
  >
    <!-- Links - Hidden on very small screens, or we can use a simpler approach -->
    <div class="hidden sm:flex items-center gap-1 md:gap-4">
      {
        navItems.map((link) => (
          <a
            class="relative block px-2 py-2 transition hover:text-[#FAAB00] dark:hover:text-[#FAAB00]"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>

    <!-- Mobile Dropdown or just Icons? Let's use icons for mobile if text is too long -->
    <div class="flex sm:hidden items-center gap-0">
      {
        navItems.map((link) => (
          <a
            class="relative block px-1.5 py-1 transition hover:text-[#FAAB00] dark:hover:text-[#FAAB00]"
            aria-label={link.label}
            href={link.url}
          >
            <span class="text-[9px] uppercase font-bold tracking-tighter">
              {link.title === "Experience"
                ? "Exp"
                : link.title === "Experiencia"
                  ? "Exp"
                  : link.title === "Projects"
                    ? "Proj"
                    : link.title === "Proyectos"
                      ? "Proj"
                      : link.title === "Contact"
                        ? "Cont"
                        : link.title === "Contacto"
                          ? "Cont"
                          : link.title}
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="flex items-center gap-2 border-l border-black/10 dark:border-white/10 ml-1 pl-2"
    >
      <ThemeToggle />
      <a
        href={langUrl}
        class="relative block px-2 py-2 transition hover:text-[#FAAB00] dark:hover:text-[#FAAB00] font-bold text-xs md:text-sm"
      >
        {langButtonText}
      </a>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500");
            } else {
              item.classList.remove("text-yellow-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-2xl ring-1 backdrop-blur bg-[#B617E6]/40 ring-[#f4f4f4]/10;
    }
  }

  :global(.dark) nav {
    animation-name: nav-shadown-dark;
  }

  @keyframes nav-shadown-dark {
    to {
      @apply shadow-2xl ring-1 backdrop-blur bg-[#0f0c11]/80 ring-[#f4f4f4]/10;
    }
  }
</style>
