---
interface Tag {
  name: string;
  class: string;
}

interface Project {
  title: string;
  description: string;
  link: string;
  image: string;
  tags: Tag[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-col gap-y-12">
  {
    projects.map(({ image, title, description, tags, link }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-fit">
          <div
            class="relative flex flex-col items-center 
        col-span-6 row-span-5 gap-8 
        transition duration-500 ease-in-out transform 
        shadow-xl overflow-clip rounded-lg 
        sm:rounded-xl md:group-hover:translate-x-2 md:group-hover:shadow-2xl 
        lg:border-[2px] lg:border-[#0f0c11] lg:hover:border-[#B617E6]/50 lg:hover:bg-[#F4F4F4]/20"
          >
            <a href={link} target="_blank" rel="noopener">
              <img
                alt="Project screenshot"
                class="object-cover object-top w-full sm:w-fit h-56 transition duration-500 sm:h-full md:scale-100 md:group-hover:scale-125"
                src={image}
              />
            </a>
          </div>
        </div>

        <div class="flex flex-col w-full bg-[#171717]/20 border-2 border-[#F4F4F4]/10 rounded-lg pt-4 px-4 md:w-1/2 md:max-w-lg dark:bg-[#171717]/40">
          <h3 class="text-2xl font-bold text-[#0f0c11] dark:text-[#F4F4F4]">
            {title}
          </h3>
          <div>
            <div class="flex-1 mt-2 text-[#0f0c11] font-medium dark:text-[#F4F4F4]/80">
              {description}
            </div>
            <ul class="flex flex-wrap gap-x-1 gap-y-2.5 mb-6 mt-auto pt-4">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex mr-1 rounded-full text-xs font-medium ${tag.class} py-1.5 px-2 whitespace-nowrap `}
                  >
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))
  }
</div>
