---
const { class: className } = Astro.props;
---

<div class={`flex items-center justify-center ${className}`}>
    <span
        class="text-[#0f0c11] text-xs text-nowrap font-semibold px-4 py-2 rounded-full dark:text-[#F4F4F4] border-[2px] border-[#B617E6] hover:scale-110 hover:text-[#F4F4F4] hover:bg-[#B617E6] hover:dark:bg-[#B617E6] hover:dark:text-[#F4F4F4] transition duration-200 md:text-lg w-full text-center flex items-center justify-center gap-2"
    >
        <slot />
    </span>
</div>
